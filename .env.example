# Azure AI Foundry / Azure OpenAI endpoint
# e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# API key for authentication
AZURE_OPENAI_API_KEY=your-api-key-here

# API version (default: 2024-12-01-preview)
API_VERSION=2024-12-01-preview

# The "router" deployment name configured in Azure AI Foundry
DEPLOYMENT_NAME=your-router-deployment

# Router mode: balanced | cost | quality (if applicable)
MODE=balanced

# Number of times each prompt is sent (default: 3)
RUNS_PER_PROMPT=3

# HTTP request timeout in seconds (default: 60)
TIMEOUT_S=60

# Directory for output files (default: ./out)
OUTPUT_DIR=./out
