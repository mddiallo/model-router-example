# Azure AI Foundry Model Router Configuration
# Copy this file to .env and fill in your actual values

# Your Azure AI Foundry endpoint URL
# Example: https://your-resource.inference.ai.azure.com
AZURE_INFERENCE_ENDPOINT=your-endpoint-url-here

# Your Azure AI Foundry API key
# Get this from the Azure Portal under your AI Foundry resource
AZURE_INFERENCE_CREDENTIAL=your-api-key-here
